{
  "name": "investtech",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_PATH=./node_modules next dev -p 3010",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:unused": "eslint src --ext .ts,.tsx --rule '@typescript-eslint/no-unused-vars: error'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pr:check": "npm run format && npm run lint && npm run typecheck && npm run test",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:integration": "jest integration-tests --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "npm run test && npm run test:integration && npm run test:e2e"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.1.1",
    "@tanstack/react-query": "^5.80.6",
    "@types/dompurify": "^3.0.5",
    "axios": "^1.12.0",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.5.19",
    "date-fns": "^4.1.0",
    "dompurify": "^3.3.0",
    "investtech": "github:kjellerdev/investtech-components",
    "isomorphic-dompurify": "^2.33.0",
    "lucide-react": "^0.514.0",
    "next": "^16.1.6",
    "next-intl": "^4.1.0",
    "next-themes": "^0.4.6",
    "nuqs": "^2.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.57.0",
    "tailwind-merge": "^3.3.1",
    "vaul": "^1.1.2",
    "zod": "^3.25.61",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "playwright": "^1.57.0",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.12",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tw-animate-css": "^1.3.4",
    "typescript": "^5"
  },
  "overrides": {
    "diff": ">=8.0.3",
    "tar": ">=7.5.3",
    "test-exclude": "^7.0.1",
    "jsdom": "^27.4.0",
    "node-domexception": "file:./patches/node-domexception-native",
    "eslint": {
      "ajv": "6.12.6"
    },
    "@eslint/eslintrc": {
      "ajv": "6.12.6"
    },
    "ajv": "^8.18.0",
    "minimatch": "^10.0.0"
  }
}
